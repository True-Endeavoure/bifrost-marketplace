{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-bg-wake.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "https://bifrost-api.com/hooks/peek",
            "timeout": 5,
            "headers": {
              "Authorization": "Bearer $BIFROST_API_KEY"
            },
            "allowedEnvVars": ["BIFROST_API_KEY"]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "https://bifrost-api.com/hooks/compact",
            "timeout": 10,
            "headers": {
              "Authorization": "Bearer $BIFROST_API_KEY"
            },
            "allowedEnvVars": ["BIFROST_API_KEY"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh\"",
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
